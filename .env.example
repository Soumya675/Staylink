# StayLink — Production & Local Development Environment Variables

# Node & Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="https://staylink.in"

# JWT Authentication & Password Security
JWT_SECRET="replace-with-a-cryptographically-secure-random-64-char-string"
SESSION_COOKIE_SECRET="replace-with-secure-session-cookie-secret"
PASSWORD_SALT_ROUNDS=12

# PostgreSQL & Prisma Database (Section 10)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://staylink_user:secure_password@localhost:5432/staylink_db?schema=public"

# Cloudinary / S3 Image Storage (Section 11)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Maps Platform Integration (Section 8)
GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsPlatformKey"

# Transactional Email (SendGrid / Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_your_api_key"
FROM_EMAIL="noreply@staylink.in"

# SMS OTP Provider (Twilio / Fast2SMS / MSG91)
SMS_PROVIDER_API_KEY="your_sms_gateway_api_key"
SMS_SENDER_ID="STAYLK"

# Optional Razorpay Payment Gateway (Section 13)
RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourKeySecret"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecret"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
